<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
   ai-code-helper 构建描述文件
  ============================================================================
   技术栈：
     - Java 21（必须！LangChain4j 1.x 要求 JDK 17+，本项目统一用 21）
     - Spring Boot 3.5.7
     - LangChain4j 1.20.0（1.x 正式版线，区别于 0.x 的包名与 API）
     - 通义千问 qwen-max（通过阿里云 DashScope 接入）
  ============================================================================
   版本管理说明（重要，别当笔误）：
     LangChain4j 的版本号分两条线：
       1) 核心线  langchain4j / langchain4j-core          -> 1.20.0（正式版）
       2) 扩展线  mcp / agentic / guardrails / reactor 等 -> 1.20.0-beta30
     扩展模块仍处于 beta，版本号形如 <核心版本>-beta<序号>，
     与核心版本同步递增。所以本 pom 中两类坐标的 version 写法不同。
  ============================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      继承 Spring Boot 官方父 POM。作用有三个：
        1. 统一管理 Spring 全家桶的依赖版本（所以下面 spring-boot-starter-web 不用写 version）
        2. 自动配置 maven-compiler-plugin 的编译参数 —— 其中最关键的是 -parameters，
           它会把方法参数名保留进 class 文件。Spring MVC 靠它做 query 参数按名绑定
           （这就是 AiController 里 `int memoryId, String message` 能直接工作的原因），
           LangChain4j 的 Agentic 模块也靠它省略 @V 注解。删掉它是会出问题的。
        3. 提供 spring-boot-maven-plugin，用来打可执行 fat jar
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.7</version>
        <relativePath/> <!-- 留空表示从远程仓库查找父 POM，而不是找上级目录 -->
    </parent>

    <groupId>com.yupi</groupId>
    <artifactId>ai-code-helper</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>ai-code-helper</name>
    <description>ai-code-helper</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>

    <properties>
        <!-- 编译与运行都走 Java 21：支持 record、文本块、虚拟线程、模式匹配等语法 -->
        <java.version>21</java.version>
        <!--
          把 LangChain4j 的版本抽成属性集中管理。
          升级时只改这里，避免漏改某个模块导致版本错配。
          版本错配的典型症状：NoSuchMethodError / NoClassDefFoundError，
          因为不同模块之间 API 签名不一致。
        -->
        <langchain4j.version>1.20.0</langchain4j.version>
        <langchain4j.beta.version>1.20.0-beta30</langchain4j.beta.version>
    </properties>

    <dependencies>
        <!-- ==================== Web 基础 ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <!-- 内含 Tomcat + Spring MVC + Jackson。
                 注意：本项目要返回 Flux（响应式流）来做 SSE，那是由下面
                 langchain4j-reactor 把 Reactor 引入类路径才实现的，
                 并不是这个 starter 提供的。 -->
        </dependency>

        <!--
          参数校验（Bean Validation）。
          提供 jakarta.validation 注解（@NotBlank / @Size / @Min ...）与 Hibernate Validator 实现。
          Spring Boot 3 起校验已从 web starter 中剥离，需要显式引入这个 starter
          ——不引它的话 @Valid 注解会被静默忽略，接口照常接收空消息，
          直到模型调用失败才暴露问题（这是很容易踩的一个坑）。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
          OpenAPI 3 文档 + Swagger UI（springdoc）。
          注意选型：springdoc-openapi 是当前 Spring Boot 3 生态的主流方案，
          已取代早年的 springfox（后者对 Spring Boot 3 支持不佳）。
          引入后无需任何配置即可访问：
              /api/swagger-ui.html   —— 可交互的接口调试页面
              /api/v3/api-docs       —— 原始 OpenAPI JSON
          前缀 /api 来自下面 application.yml 里的 server.servlet.context-path。
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.10</version>
        </dependency>

        <!-- ==================== LangChain4j 核心 ==================== -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
            <version>${langchain4j.version}</version>
            <!-- 核心包：AiServices 动态代理、ChatModel 抽象、RAG 检索器、
                 文档加载/切割、向量库接口等都在这里 -->
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-core</artifactId>
            <version>${langchain4j.version}</version>
            <!-- 最底层的抽象与 SPI：ChatMemory、EmbeddingModel、
                 Document、TextSegment、ChatModelListener 等。
                 它本会被 langchain4j 传递引入，显式声明是为了让依赖关系一眼可见。 -->
        </dependency>

        <!--
          通义千问（DashScope）的 Spring Boot Starter。
          它的价值在于「自动装配」：只要在 application.yml 里按约定写好
          langchain4j.community.dashscope.chat-model.* 等配置，
          它就会自动往容器里注册三个 Bean：
              ChatModel            —— 同步对话模型
              StreamingChatModel   —— 流式对话模型
              EmbeddingModel       —— 向量化模型
          业务代码直接 @Resource 注入即可，不用手写任何模型构造代码。
        -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-community-dashscope-spring-boot-starter</artifactId>
            <version>${langchain4j.beta.version}</version>
        </dependency>

        <!--
          Reactor 适配：让 LangChain4j 的流式接口返回 Flux<String>。
          没有它，StreamingChatModel 只能给出回调式 API（onNext/onComplete），
          无法直接与 Spring MVC 的响应式返回值类型对接，也就写不出
          AiController 里那种「返回 Flux<ServerSentEvent<String>>」的写法。
        -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-reactor</artifactId>
            <version>${langchain4j.beta.version}</version>
        </dependency>

        <!-- ============ LangChain4j 扩展模块（原项目缺失的新能力） ============ -->

        <!--
          MCP（Model Context Protocol）客户端。
          用途：把外部的 MCP Server 当成「工具仓库」接进来，
          让大模型能调用远程工具（联网搜索、读写数据库、浏览器操作等），
          而不需要把这些工具一个个手写成 @Tool 方法。
          关键类：McpClient / McpToolProvider / StreamableHttpMcpTransport
          注意：必须用 LangChain4j 自己的 MCP 实现，不要和 Spring AI 的
          io.modelcontextprotocol 那套混用，两套 SDK 类型不兼容（原 McpConfig 的坑）。
        -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-mcp</artifactId>
            <version>${langchain4j.beta.version}</version>
        </dependency>

        <!--
          Agentic 模块：声明式「多 Agent 工作流」编排（1.3.0 起新增）。
          用途：把多个各司其职的 Agent 用代码串成顺序 / 并行 / 循环 / 条件工作流，
          例如「学习路线规划 → 面试题检索 → 汇总建议」这样的流水线。
          关键类：AgenticServices、@Agent、@V、UntypedAgent
          它比单个 AI Service 更适合「复杂任务拆解」场景。
        -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-agentic</artifactId>
            <version>${langchain4j.beta.version}</version>
        </dependency>

        <!--
          Guardrails 护栏模块：对输入和输出做程序化校验与拦截（1.9.0 起新增）。
          用途：把「安全检查」从提示词里搬进 Java 代码，形成确定性防线：
              - 输入护栏：拦截提示词注入、超长输入、敏感话题
              - 输出护栏：校验格式、过滤不当内容、发现违规时重试或替换
          相比「在 system prompt 里写请勿回答违规问题」，护栏是代码级强约束，
          模型无法绕过。关键接口：InputGuardrail / OutputGuardrail
        -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-guardrails</artifactId>
            <version>${langchain4j.beta.version}</version>
        </dependency>

        <!-- ==================== 工具类 ==================== -->

        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.20.1</version>
            <!-- 用于 InterviewQuestionTool 抓取面试鸭页面并做 DOM 解析。
                 属于「没有官方 API 时的兜底方案」，稳定性受目标站点改版影响。 -->
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
            <!-- 编译期注解处理器，提供 @Slf4j / @Data 等。
                 optional=true 表示不传递给下游依赖。
                 运行期不需要它（注解已编译进字节码），见 build 中的 exclude 配置。 -->
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <!-- scope=test：只在测试编译与运行时可见，不会打进最终产物 -->
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <!-- 版本交由父 POM 管理。显式列出是为了将来加
                     annotationProcessorPaths（如 Lombok、MapStruct）时有落脚点。 -->
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                    <!-- 打出的 fat jar 里排除 Lombok：它是编译期工具，
                         运行时没有任何代码会引用它，打进去只会白白增大体积。 -->
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
